{
  "manifest_version": 3,
  "name": "WebLens",
  "version": "0.1.0",
  "description": "Real-time early warning for phishing and malicious URLs.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "WebLens",
    "default_popup": "src/popup/popup.html"
  }
}
